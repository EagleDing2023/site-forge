# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright MCP output
/.playwright-mcp/

# Impeccable working files
/.impeccable/

# Private: agent instructions, tooling and planning docs (kept locally, never published)
/CLAUDE.md
CLAUDE.local.md
/AGENTS.md
/.claude/
/.mcp.json
# Handoff stays private except the files the tests read.
/site-forge-handoff/*
!/site-forge-handoff/data/
/site-forge-handoff/data/*
!/site-forge-handoff/data/catalog.js
!/site-forge-handoff/data/catalog-v2.js
!/site-forge-handoff/refs/
/site-forge-handoff/refs/*
!/site-forge-handoff/refs/prototype.dc.html

# editors
.vscode/
.idea/
